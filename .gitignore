# 环境变量（含 API Key，勿提交）
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
*.egg

# IDE（仅跟踪工作区终端 UTF-8 等共享设置）
.vscode/*
!.vscode/settings.json
.idea/

# OS
.DS_Store
Thumbs.db

# Docker volumes
redis_data/
neo4j_data/

# Unity local secrets (copy from *.example.json — never commit real values)
unity/*/Assets/Resources/parrot_config.json
unity/*/Assets/Resources/parrot_config.json.meta
unity/*/Assets/Resources/parrotdev.json
unity/*/Assets/Resources/parrotdev.json.meta
unity/*/Assets/ParrotApp/Resources/parrot_config.json
unity/*/Assets/ParrotApp/Resources/parrot_config.json.meta
unity/*/Assets/ParrotApp/Resources/parrotdev.json
unity/*/Assets/ParrotApp/Resources/parrotdev.json.meta

# Unity (both ParrotDev and future ParrotAR)
unity/*/Library/
unity/*/Temp/
unity/*/Obj/
unity/*/Build/
unity/*/Builds/
unity/*/Exported*/
unity/*/gradleOut/
unity/*/Logs/
unity/*/UserSettings/
unity/*/MemoryCaptures/
# Large Unity local package archives; use artifact/LFS/download source for remote repro.
unity/*/Packages/com.github.homuler.mediapipe-*.tgz
*.csproj
*.sln

# Cursor ECS sync pack — real secrets live here locally + rsync to Castle; never commit
# Naming: *.deploymirror / *.deploymirror.json — avoids root `.env.*` pattern; still ignored here.
.cursor/config/*.deploymirror
.cursor/config/*.deploymirror.json
.cursor/config/castle-deploy.keys
.cursor/config/nanobot-parrot.config.sync.json

# Cursor internal (plans are Cursor-generated, not project docs)
.cursor/plans/
terminals/
agent-transcripts/

# Cursor skills: auto-generated reference docs (large, regeneratable)
.cursor/skills/*/references/

# Cursor memory: AI session files that may contain secrets or temp state
.cursor/memory/active_context.md
.cursor/memory/log.txt
.cursor/memory/BigIssue.md
.cursor/memory/deploy_snapshot_*.md

# Nanobot local workspace (persona/session data)
.nanobot/

# Google Cloud 服务账号 JSON（含私钥，绝不提交）
*service-account*.json
*-sa-key.json
*-adc.json

# ECS 本地 secrets 目录（service account JSON、voiceprint manifest 等）
data/secrets/

# Local laptop Castle/ECS sandbox. Generated from infra/laptop.env.example by
# infra/laptop-castle.ps1; contains local-only secrets, generated LiveKit config,
# runtime_config, Redis/Falkor state, and Unity parrot_config variants.
/infra/laptop.env.local
/codex_workspace/local_runtime/

# Temporary transfer files / build artifacts
FilePort/
FilePort2/
FilePort3/
*.tar.gz
*.tar.bz2
*.tgz
*.apk
*.aab
*.apks
*.ipa
*.symbols.zip
*.zip
# Root-only: legacy local harness (was `Test/` — on Windows that also ignored `docs/test/`)
/Test/
*.token.txt
unity_join_token.txt

# Local design asset staging.
# Keep curated decisions/docs in git, but do not commit the raw downloaded
# Pixel Asset packs or the bulk extracted workspace. Small production-ready
# sprites should be copied into a dedicated Unity asset folder when selected.
/Pixel Asset/
/codex_workspace/design_workspace/asset_pipeline/pixel_asset_workspace/

# Unity smoke screenshots are generated verification artifacts.
/unity/*/Assets/Screenshots/
/unity/*/Assets/Screenshots.meta
