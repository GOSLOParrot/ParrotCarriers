# infra/Dockerfile.brain
# Castle Python service image. Two build stages:
#
#   `base`  — slim runtime used by token-mint and the Phase 2
#             orchestrator. Dependencies: project core + fastapi +
#             uvicorn + livekit-api.
#   `full`  — extends `base` with the full Brain runtime (livekit-agents,
#             google-genai realtime, memory extras for FalkorDB/Graphiti,
#             livekit-plugins-silero/google/cartesia). Used by the
#             Phase 3.2 brain service in docker-compose.
#
# Build context: repo root (docker-compose sets context: ..)
# Usage:
#   docker compose -f infra/docker-compose.yml build token-mint
#   docker compose -f infra/docker-compose.yml --profile brain up -d brain
#
# Stage selection:
#   docker compose `target: base` (token-mint, orchestrator) keeps the
#   image small (~250 MB). `target: full` (brain) ~1.2 GB.

# ── Stage 1: base ────────────────────────────────────────────────────
FROM python:3.11-slim AS base

WORKDIR /app

# System packages needed by cryptography (used by livekit-api JWT signing)
# and by some Pydantic C extensions.
RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc libffi-dev \
    && rm -rf /var/lib/apt/lists/*

# --- Dependency layer (changes rarely) ---
# Copy only the project definition first so Docker can cache this layer
# independently of source changes.
COPY pyproject.toml ./

# Create a stub src/parrot/__init__.py so pip install -e . succeeds
# without copying the full source yet (source copied below).
RUN mkdir -p src/parrot && touch src/parrot/__init__.py

# Install the package in editable mode (main deps only — no [memory] extras
# because token-mint does not need graphiti/falkordb/rustworkx).
# Then install service-specific extras:
#   fastapi        — HTTP framework for /mint endpoint and orchestrator
#   uvicorn        — ASGI server
#   livekit-api    — server-side AccessToken / VideoGrants JWT generation
#                    NOTE: this is distinct from livekit-agents (client SDK)
#   httpx          — orchestrator client SDK transport
RUN pip install --no-cache-dir \
        -e "." \
        "fastapi>=0.110,<1.0" \
        "uvicorn[standard]>=0.29,<1.0" \
        "livekit-api>=0.7,<2.0" \
        "httpx>=0.25,<1.0"

# --- Source layer (changes every commit) ---
# Copy full source after deps so code changes don't invalidate the dep cache.
COPY src/ ./src/
COPY data/ ./data/

# Non-root user for security (Castle ECS policy: run as uid 1000)
RUN useradd -m -u 1000 parrot && chown -R parrot:parrot /app
USER parrot

# Default entry point — overridden by docker-compose `command:`
CMD ["python", "-m", "parrot.castle.token_mint"]


# ── Stage 2: full (Brain agent) ──────────────────────────────────────
# Inherits from base so the Python venv, project layout, and source
# tree are reused. Adds the LiveKit agents client SDK + memory extras.
FROM base AS full

USER root
RUN pip install --no-cache-dir -e ".[memory]" \
    && pip install --no-cache-dir \
        "livekit-agents>=0.10,<1.0" \
        "livekit-plugins-google>=0.6,<1.0" \
        "livekit-plugins-silero>=0.6,<1.0"
USER parrot

# Phase 3.2: Brain entrypoint. The dev/prod selection is via env
# (PARROT_BRAIN_MODE=dev|prod) so the same image works in both flows.
CMD ["python", "-m", "parrot.brain.agent", "dev"]
