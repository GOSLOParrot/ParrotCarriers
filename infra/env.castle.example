# Castle ECS 环境变量模板 (2C8G, 东京)
# 复制到 Castle 上的 .env 后填入真实值

# Google / Gemini
GOOGLE_API_KEY=<your-gemini-api-key>

# LiveKit Server (同机 Docker)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=<generate-a-real-key>
LIVEKIT_API_SECRET=<generate-a-real-secret-32chars-min>
LIVEKIT_ROOM=parrot-main

# Redis (Docker 内网，Brain/Scheduler 从宿主机访问)
REDIS_HOST=localhost
REDIS_PORT=6379

# Debug
PARROT_DEBUG=false
