[Unit]
Description=Parrot GOSLO Chat Nanobot (Telegram)
After=network-online.target docker.service parrot-orchestrator.service
Wants=network-online.target docker.service parrot-orchestrator.service
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
Type=simple
User=root
WorkingDirectory=/opt/parrot/ParrotCarriers
EnvironmentFile=-/opt/parrot/ParrotCarriers/.env.castle
Environment=PYTHONUNBUFFERED=1
# Venv bin in PATH + HOME stays /root where goslo-workspace lives
Environment=PATH=/opt/parrot/ParrotCarriers/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/opt/parrot/ParrotCarriers/.venv/bin/python src/scripts/start_goslo_chat.py
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/parrot/ParrotCarriers/data
ReadWritePaths=/opt/parrot/ParrotCarriers/logs

[Install]
WantedBy=multi-user.target
