[Unit]
Description=Parrot Maid Nanobot (parrot_bus + WeChat)
After=network-online.target docker.service parrot-orchestrator.service
Wants=network-online.target docker.service parrot-orchestrator.service

[Service]
Type=simple
User=parrot
WorkingDirectory=/opt/parrot/ParrotCarriers
EnvironmentFile=-/opt/parrot/ParrotCarriers/.env.castle
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/parrot/ParrotCarriers/.venv/bin/python src/scripts/start_nanobot_worker.py
Restart=on-failure
RestartSec=5s
StartLimitBurst=5
StartLimitIntervalSec=60
TimeoutStopSec=20s
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/parrot/ParrotCarriers/data
ReadWritePaths=/opt/parrot/ParrotCarriers/logs

[Install]
WantedBy=multi-user.target
