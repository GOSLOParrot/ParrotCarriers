# ParrotCarriers laptop Castle sandbox.
# Copy to infra/laptop.env.local via infra/laptop-castle.ps1 -Action init.
# This file is intentionally placeholder-only; do not paste ECS secrets here.

PARROT_LAPTOP_HOST=127.0.0.1

LIVEKIT_URL=ws://127.0.0.1:17880
LIVEKIT_ROOM=parrot-laptop-main
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=parrot_carriers_local_dev_livekit_secret_key_v1

PARROT_MINT_SECRET=local_laptop_mint_secret_change_me
PARROT_MINT_AGENT_DISPATCH=unity
PARROT_MINT_ACTIVE_AGENT_DISPATCH=1
PARROT_MINT_ACTIVE_AGENT_DISPATCH_TIMEOUT_SECONDS=4.0
PARROT_MINT_LIVEKIT_INTERNAL_URL=ws://livekit:7880
PARROT_MINT_TTL_SECONDS=600

PARROT_ORCH_SECRET=local_laptop_orch_secret_change_me
PARROT_ORCH_HOST=0.0.0.0
PARROT_ORCH_PORT=7890

PARROT_APP_MONITOR_SECRET=local_laptop_app_api_secret_change_me

PARROT_PHOTO_UPLOAD_HOST=0.0.0.0
PARROT_PHOTO_UPLOAD_PORT=7889
PARROT_PHOTO_CACHE_ROOT=/app/data/photos

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
FALKORDB_HOST=falkordb
FALKORDB_PORT=6379
PARROT_RUNTIME_CONFIG_PATH=/app/data/runtime_config.json

# Default laptop comparison path is LineA. To run Brain locally, add a local
# GOOGLE_API_KEY in laptop.env.local. Do not copy the ECS .env wholesale.
PARROT_LLM_PIPELINE=line_a
PARROT_ACTIVE_LINE_PROFILE_ID=
PARROT_ACTIVE_ROOM_PROFILE_ID=default
GOOGLE_API_KEY=
GEMINI_API_KEY=

PARROT_DEBUG=true
PARROT_LOG_LEVEL=INFO
