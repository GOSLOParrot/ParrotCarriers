# Copy to .env.laptop for ReactFlow Web Console dev mode.
# The generated .env.laptop file is ignored by git.
PARROT_WEB_CONSOLE_PROFILE=laptop
# Point ReactFlow at the local Web Console BFF. The BFF fans out to laptop
# app-monitor/orchestrator/Graphiti/LiveKit services.
PARROT_WEB_CONSOLE_API_TARGET=http://127.0.0.1:7893
